$ErrorActionPreference = 'Stop'
$env:PATH = '@SIMDIS_SDK_DIR@/bin;' + $env:PATH
$env:SIMDIS_SDK_FILE_PATH = '@SIMDIS_DATA_DIR@'
$env:GDAL_DATA = '@SIMDIS_SDK_DIR@/data/GDAL'
$env:GDAL_DRIVER_PATH = '@SIMDIS_SDK_DIR@/bin/gdalplugins'
